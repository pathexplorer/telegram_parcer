# ──────────────────────────────────────────────────────────────────────
# Telegram Parser — local environment variables (EXAMPLE)
# ──────────────────────────────────────────────────────────────────────
# Copy this file to keys.env and fill in your real values.
#   cp keys.env.example keys.env
#
# IMPORTANT: never commit keys.env to version control — it's in .gitignore.
# ──────────────────────────────────────────────────────────────────────

# Your GCP project ID (required).
PROJECT_ID=your-gcp-project-id

# Name of the Secret Manager secret that holds the Telegram credentials
# (API_ID, API_HASH, BOT_TOKEN, session_string) as a JSON object.
TELEGRAM_SECRETS=telegram-secrets

# Telegram chat ID where keyword alerts are delivered.
# Must be an integer (negative for group chats).
NOTIFICATION_CHAT=-1001234567890

# ── Authentication (pick ONE) ─────────────────────────────────────────
# Preferred: Application Default Credentials (ADC).
# Run `gcloud auth application-default login` and leave this empty.
GOOGLE_APPLICATION_CREDENTIALS=

# Fallback (NOT recommended): path to a downloaded service-account JSON key.
# Long-lived keys are a security risk — use ADC whenever possible.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# ── Optional runtime settings ─────────────────────────────────────────
# Max time (seconds) the polling loop is allowed to run.
# Default: 450 (leaves ~90 s buffer below the 540 s Gen1 function limit).
# MAX_POLL_SECONDS=450

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOGGING_LEVEL=INFO
